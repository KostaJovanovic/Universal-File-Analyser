{
  // Analyser - main compile. src/*.ts -> web/assets/js/*.js, 1:1, never bundled.
  // The emitted tree IS what ships and what sw.js's SHELL, check-shell.mjs and
  // the prerender generators all read, so the module graph must survive intact:
  // every import specifier is written with a .js extension in source and is
  // emitted verbatim.
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "rootDir": "src",
    "outDir": "web/assets/js",

    "sourceMap": true,
    "inlineSources": true,

    // The tree compiles CLEAN at this posture - keep it that way, and treat any
    // new error as a real one rather than migration noise.
    //
    // `strict` stays off because it is really two very different asks. The
    // cheap half is on below. The expensive half is strictNullChecks +
    // noImplicitAny, which together report ~5,400 sites: mostly "this DOM query
    // / parse result might be null", which is true but needs a real guard at
    // each site, not an annotation. Adding those guards changes runtime
    // behaviour in a codebase with no tests, so it is its own piece of work -
    // do it a directory at a time (core -> lib -> parsers -> games ->
    // renderers), never alongside another change.
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false
  },
  "include": ["src", "types"],
  "exclude": [
    "node_modules",
    "web",
    "tools",
    "worker",
    // Compiled by tsconfig.worker.json instead - they need the WebWorker lib,
    // which collides with DOM (both declare self/postMessage).
    "src/lib/dfn-worker.ts",
    "src/lib/mdx-worker.ts",
    "src/renderers/audio-dsp-worker.ts"
  ]
}
