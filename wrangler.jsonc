{
  // Explicit config so the deploy is reproducible (otherwise wrangler
  // auto-generates this on every build). Mirrors the auto-detected settings,
  // plus not_found_handling so unknown URLs serve the custom 404 page
  // (web/404.html) with a real 404 status, instead of silently landing on the
  // home page. Every real route (/about, /formats/<ext>, ...) is a file, so only
  // genuinely-missing paths hit it.
  //
  // ── SETUP (one-time, for the stats Worker in worker/index.js) ───────────────
  // The site is otherwise a pure static-asset deploy; the Worker only powers the
  // visitor / file-analysis counters (/api/*). Before the first deploy that
  // includes it, run these once (then push as usual - Cloudflare builds the rest):
  //   1. wrangler d1 create analyser-stats
  //        → paste the printed database_id into "d1_databases[0].database_id" below.
  //   2. wrangler d1 execute analyser-stats --remote --file=worker/schema.sql
  //        → creates the tables.
  //   3. wrangler secret put IP_SALT
  //        → any long random string; salts the IP hash used for visit dedup.
  // Local testing: `wrangler dev` (uses a local D1). `server.bat` has no Worker,
  // so /api/* is mocked by serve.py for local page previews.
  // ────────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker service name. Renamed from "lab" to "analyser" on 2026-07-25 when the
  // site's canonical host became analyser.valjdakosta.com. Both custom domains -
  // analyser.valjdakosta.com (canonical: every canonical tag, sitemap, share URL
  // and absolute link points there) and the legacy lab.valjdakosta.com, which
  // now 307-redirects to the canonical host (see worker/index.js) - are attached
  // to THIS service. Changing this name again means re-attaching both domains,
  // re-adding the IP_SALT secret and re-connecting the GitHub build, so don't.
  "name": "analyser",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-03",
  "observability": { "enabled": true },
  "assets": {
    "directory": "web",
    // Named binding so the Worker can hand non-/api requests back to the assets
    // system (env.ASSETS.fetch), preserving clean URLs + the 404 handling.
    "binding": "ASSETS",
    // Default html_handling ("auto-trailing-slash"): clean URLs are canonical.
    // /about serves about.html, and /about.html 308-redirects to /about (same
    // for /patch and /index.html -> /). Every link, canonical URL, the sitemap
    // and the service-worker precache use the clean form to match, and the local
    // dev server (serve.py) mirrors this exact routing. not_found_handling serves
    // the custom 404 page (web/404.html) with a 404 status for any unknown path.
    "not_found_handling": "404-page",
    // Normally a request that matches a static file is served straight from the
    // asset store and never reaches the Worker - which would leave the legacy-host
    // redirect in worker/index.js unable to see page requests like
    // lab.valjdakosta.com/about. This routes everything through the Worker first,
    // which then hands non-/api requests back via env.ASSETS.fetch (same clean
    // URLs, _headers and 404 handling as before). /assets/* is excluded: it is the
    // bulk of the requests (js, css, fonts, wasm, vendor) and subresources don't
    // need redirecting, so they keep bypassing the Worker entirely.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "compatibility_flags": ["nodejs_compat"],
  // D1 database backing the counters. database_id is filled in during SETUP above.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "analyser-stats",
      "database_id": "a891d19c-83cf-49cd-a251-9e457413bcc7"
    }
  ],
  // Rate-limit binding: at most 15 /api/analysed writes per 60s per (hashed) IP,
  // so a scripted loop can't inflate the file counter. period must be 10 or 60.
  "unsafe": {
    "bindings": [
      {
        "name": "ANALYSED_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 15, "period": 60 }
      }
    ]
  }
}
