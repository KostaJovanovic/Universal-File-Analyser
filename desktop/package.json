{
  "name": "analyser-desktop",
  "productName": "Analyser",
  "version": "8.46.0",
  "private": true,
  "type": "module",
  "description": "Desktop shell for Analyser. Wraps the same web/ tree the website serves - no fork of the app code.",
  "author": "Kosta Jovanovic",
  "homepage": "https://analyser.valjdakosta.com",
  "license": "UNLICENSED",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "stamp": "node tools/stamp-version.mjs",
    "dist": "node tools/stamp-version.mjs && electron-builder --win --publish never",
    "dist:mac": "node tools/stamp-version.mjs && electron-builder --mac --publish never",
    "dist:linux": "node tools/stamp-version.mjs && electron-builder --linux --publish never",
    "pack": "node tools/stamp-version.mjs && electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
