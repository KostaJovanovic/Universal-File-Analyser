<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. allowBackup="false" already turns backup off
     there; this excludes every domain as well, so turning allowBackup back on
     by mistake still backs up nothing. data_extraction_rules.xml is the
     Android 12+ twin. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
