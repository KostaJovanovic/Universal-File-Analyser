<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No backup and no device transfer: the WebView's storage holds the
         "Recently analysed" list (file names, sizes, types), and nothing about
         the user's files leaves the phone. res/xml/data_extraction_rules.xml
         (Android 12+) and backup_rules.xml (older) exclude every domain. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with": any file, from any app. Listed in the chooser, never
                 made the default - Android only does that when the user asks.
                 AnrShell.deliver() hands it to the page as the desktop's open
                 payload. content:// only; file:// is refused there. -->
            <intent-filter android:label="Analyse">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- "Share to Analyser" from the gallery, the Files app, a mail app. -->
            <intent-filter android:label="Analyse">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- AnrUpdate's install session reports here. Not exported: only the
             PendingIntent the session was committed with can reach it. -->
        <receiver
            android:name=".AnrUpdate$InstallStatus"
            android:exported="false" />

        <!-- AnrJobService keeps an ffmpeg job alive while the app is in the
             background, with a progress notification. mediaProcessing is the
             type Android 15 made for this. dataSync covers Android 10 to 14,
             which do not know it. -->
        <service
            android:name=".AnrJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Capacitor's chrome client uses this for one thing: the photo a
             file input takes with the camera (BridgeWebChromeClient,
             getExternalFilesDir(Pictures)). res/xml/file_paths.xml shares that
             folder and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- audio.ts records from the microphone (getUserMedia). Capacitor's chrome
         client asks for this at runtime when the page does, never before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- AnrUpdate.java hands a downloaded update to the system installer, which
         then asks the user. A Google Play build must remove this line: Play
         forbids an app that updates itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- AnrJobService. A foreground service needs the first, plus one for each
         type it runs as. The notification needs the last on Android 13 and
         later: the app asks for it once, at the first ffmpeg job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
